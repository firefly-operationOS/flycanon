# All keys are prefixed with FLYCANON_ so they are easy to grep for and
# easy to scope per service.

# ----------------------------------------------------------------------------
# Service
# ----------------------------------------------------------------------------
FLYCANON_LOG_LEVEL=INFO
FLYCANON_PORT=8500

# ----------------------------------------------------------------------------
# Persistence
# ----------------------------------------------------------------------------
# Async-SQLAlchemy URL. asyncpg for Postgres, aiosqlite for SQLite (tests).
FLYCANON_DATABASE_URL=postgresql+asyncpg://canon:canon@localhost:5432/flycanon

# Run alembic upgrade head on startup (set to "false" in production deploys
# that prefer migrating as a separate step).
RUN_MIGRATIONS=true

# ----------------------------------------------------------------------------
# Queue / EDA
# ----------------------------------------------------------------------------
# Choose ``memory`` (single-process dev), ``postgres`` (default -- durable
# outbox + LISTEN/NOTIFY, no extra broker needed since the service already
# runs Postgres), ``redis`` (Redis Streams), or ``kafka`` (production
# fan-out). All adapters live in ``pyfly.eda.adapters``.
FLYCANON_EDA_ADAPTER=postgres
FLYCANON_REDIS_URL=redis://localhost:6379/0

# Per-adapter backend selection for the auth rate limiter + replay
# idempotency store.
#   auto       -- (default) Redis when FLYCANON_REDIS_URL is set,
#                 else the in-process implementation.
#   redis      -- always Redis (errors at first use if Redis is
#                 unreachable).
#   in_memory  -- always the in-process variant (per-replica
#                 buckets / dict; not durable across restarts or
#                 shared across replicas).
# In-memory is fine for single-replica dev / test posture; production
# behind a load balancer MUST use ``redis`` for both so the per-token
# rate-limit window and the replay cache are shared across replicas.
FLYCANON_RATE_LIMIT_BACKEND=auto
FLYCANON_IDEMPOTENCY_BACKEND=auto

# Topics for the lifecycle events flycanon publishes. Downstream services
# subscribe to these to keep their projections in sync.
FLYCANON_INGEST_TOPIC=flycanon.ingest
FLYCANON_KNOWLEDGE_TOPIC=flycanon.knowledge
FLYCANON_AUDIT_TOPIC=flycanon.audit

# ----------------------------------------------------------------------------
# Worker concurrency
# ----------------------------------------------------------------------------
# The IngestWorker subscribes to four event families (Source*, Knowledge*,
# Candidate*, audit) and dispatches each delivery through a bounded
# semaphore so a burst doesn't blow up the async pool or an LLM rate
# limit. Tune these for the bandwidth of your downstream services.
#   max_concurrency    -- inflight handler tasks cap.
#   handler_timeout_s  -- per-handler wall-clock cap (a stuck downstream
#                         call cannot pin a worker slot indefinitely).
#   shutdown_grace_s   -- on stop, wait this long for inflight to drain
#                         before cancelling.
FLYCANON_WORKER_MAX_CONCURRENCY=8
FLYCANON_WORKER_HANDLER_TIMEOUT_S=120
FLYCANON_WORKER_SHUTDOWN_GRACE_S=30

# ----------------------------------------------------------------------------
# Embeddings + RAG
# ----------------------------------------------------------------------------
# Embedding provider, used by the chunk indexer and the query stage.
# Supports any pydantic-ai / fireflyframework-agentic embedder identifier
# (``openai:text-embedding-3-small``, ``cohere:embed-english-v3.0``, ...).
FLYCANON_EMBEDDING_MODEL=openai:text-embedding-3-small
FLYCANON_EMBEDDING_DIMENSIONS=1536

# Answer model for the RAG query endpoint. Any pydantic-ai provider id.
FLYCANON_ANSWER_MODEL=anthropic:claude-sonnet-4-6
FLYCANON_ANSWER_FALLBACK_MODEL=openai:gpt-4o

# Output-token budget for every FireflyAgent. Anthropic / OpenAI default
# to 4096 which silently truncates the consolidator's structured
# candidate arrays (the model writes a valid prefix, the JSON parser
# rejects the half-output, and the request returns 0 candidates with
# input_tokens=4096 in the logs). 8192 is Sonnet 4.6's public ceiling
# and matches flydocs/flyradar. Bump for models with a higher ceiling
# (long-output betas, GPT-4o 16k) when needed. The two per-stage
# overrides let you tune one stage independently of the global default.
FLYCANON_AGENT_MAX_OUTPUT_TOKENS=8192
# FLYCANON_CONSOLIDATOR_MAX_OUTPUT_TOKENS=  # default: agent_max_output_tokens
# FLYCANON_ANSWER_MAX_OUTPUT_TOKENS=        # default: agent_max_output_tokens

# Hybrid retrieval knobs.
FLYCANON_RETRIEVAL_TOP_K=10
FLYCANON_RETRIEVAL_PER_QUERY_K=30
FLYCANON_RETRIEVAL_RRF_K=60

# Optional cross-encoder reranker. Empty = disabled (the default).
# Set to ``cohere:rerank-multilingual-v3.0`` (needs COHERE_API_KEY)
# or ``voyageai:rerank-2`` (needs VOYAGEAI_API_KEY) to enable.
FLYCANON_RERANKER_MODEL=
FLYCANON_RERANKER_TOP_N=20

# Optional multi-query expansion -- the answer model rewrites the
# query into N paraphrases, each runs through the retriever, and
# the result lists are RRF-fused for higher recall. Costs +1 LLM
# call per /search and /query.
FLYCANON_QUERY_EXPANSION_ENABLED=false
FLYCANON_QUERY_EXPANSION_N=3

# ----------------------------------------------------------------------------
# PII guardrail
# ----------------------------------------------------------------------------
# The intake pipeline scans every payload (and re-ingest payload) for
# personal data before chunking + embedding. See docs/pii.md.
#   scanner:
#     regex     -- default, no dependencies. Email / US SSN / phone /
#                  credit card / IBAN patterns.
#     presidio  -- planned, falls back to regex in this build.
#     disabled  -- skip the scan entirely (dev / fixture replay).
#   policy:
#     warn      -- default; index as-is and record findings on the
#                  source row's metadata.pii_findings.
#     redact    -- rewrite each hit as [REDACTED:<KIND>] before
#                  chunking + indexing; metadata still records the
#                  original spans.
#     reject    -- fail the intake with RFC 7807 ``pii_violation``
#                  (HTTP 422) and findings[].
FLYCANON_PII_SCANNER=regex
FLYCANON_PII_POLICY=warn

# ----------------------------------------------------------------------------
# Vector store
# ----------------------------------------------------------------------------
# Backend selector. Every option implements the agentic
# VectorStoreProtocol and is wired first-class in
# ``core/services/retrieval/corpus_factory.py``.
#
#   pgvector    -- HNSW index in the canonical Postgres (extension
#                  ``vector`` required). DEFAULT -- the canonical
#                  store already runs Postgres so co-locating the
#                  vector projection means one operational service,
#                  not two. The docker-compose stack uses the
#                  ``pgvector/pgvector:pg16`` image so the
#                  ``vector`` extension is ready out of the box.
#   sqlite-vec  -- single-file SQLite (FTS5 + sqlite-vec). Best for
#                  single-node dev / test deployments.
#   chroma      -- ChromaDB (managed or self-hosted). Requires the
#                  ``chroma`` extra.
#   qdrant      -- Qdrant (self-hosted or Cloud). Requires the
#                  ``qdrant`` extra.
#   pinecone    -- Pinecone Serverless. Requires the ``pinecone`` extra.
#   memory      -- in-memory, ephemeral (test-only).
FLYCANON_VECTOR_STORE=pgvector
# SQLite path the BM25 corpus + sqlite-vec backend use. The directory
# is created on startup if it does not exist. The BM25 corpus file is
# also created for the non-sqlite-vec backends -- it's the BM25 index
# projection, not the source of truth.
FLYCANON_CORPUS_PATH=./local_data/corpus.db

# --- pgvector backend (FLYCANON_VECTOR_STORE=pgvector) ----------------------
FLYCANON_PGVECTOR_TABLE=canon_chunk_vectors
FLYCANON_PGVECTOR_HNSW_M=16
FLYCANON_PGVECTOR_HNSW_EF_CONSTRUCTION=64

# --- Chroma backend (FLYCANON_VECTOR_STORE=chroma) --------------------------
FLYCANON_CHROMA_COLLECTION=flycanon

# --- Qdrant backend (FLYCANON_VECTOR_STORE=qdrant) --------------------------
FLYCANON_QDRANT_URL=http://localhost:6333
FLYCANON_QDRANT_COLLECTION=flycanon
# FLYCANON_QDRANT_API_KEY=

# --- Pinecone backend (FLYCANON_VECTOR_STORE=pinecone) ----------------------
FLYCANON_PINECONE_INDEX=flycanon
# FLYCANON_PINECONE_API_KEY=

# ----------------------------------------------------------------------------
# Ingestion
# ----------------------------------------------------------------------------
# Chunker knobs.
FLYCANON_CHUNK_SIZE_TOKENS=1200
FLYCANON_CHUNK_OVERLAP_TOKENS=150
FLYCANON_CHUNK_STRATEGY=paragraph

# Max bytes accepted in a single source submission (after upload).
FLYCANON_MAX_BYTES=33554432

# ----------------------------------------------------------------------------
# Binary normalisation
# ----------------------------------------------------------------------------
# Master kill-switch for the binary normaliser. ``false`` bypasses
# image / archive / email / Office handling and feeds raw bytes
# directly to the loader registry -- useful when the caller already
# normalises upstream.
FLYCANON_BINARY_NORMALIZE_ENABLED=true
# Max depth + max files for archive / email expansion. Defends
# against zip-bomb style fan-out.
FLYCANON_BINARY_MAX_RECURSION_DEPTH=4
FLYCANON_BINARY_MAX_EXPANDED_FILES=50
# Office converter: ``none`` (default; rely on in-process MarkItDown),
# ``gotenberg`` (HTTP sidecar), or ``libreoffice`` (in-container
# subprocess).
FLYCANON_OFFICE_CONVERTER=none
FLYCANON_GOTENBERG_URL=http://gotenberg:3000
FLYCANON_GOTENBERG_TIMEOUT_S=60
FLYCANON_BINARY_LIBREOFFICE_PATH=soffice
FLYCANON_BINARY_LIBREOFFICE_TIMEOUT_S=60
# Tesseract OCR language. ``+``-joined ISO 639-2/B codes. The runtime
# image ships ``spa``, ``eng``, ``fra``, ``deu``, ``ita``, ``por``,
# ``cat``; extend the Dockerfile to add more.
FLYCANON_OCR_LANG=eng+spa

# ----------------------------------------------------------------------------
# Provider credentials -- pulled from the standard env vars. Set only
# the ones you need.
# ----------------------------------------------------------------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ----------------------------------------------------------------------------
# Security (optional)
# ----------------------------------------------------------------------------
# Static API keys that grant access. Comma-separated.
FLYCANON_API_KEYS=
